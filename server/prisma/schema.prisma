// This is the Prisma schema file for the Car Dealership Inventory System.
// It defines the database models for User and Vehicle entities.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Role enum for user authorization levels
enum Role {
  USER
  ADMIN
}

/// User model for authentication and authorization
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  wishlists Wishlist[]

  @@map("users")
}

/// Vehicle model representing cars in the dealership inventory
model Vehicle {
  id        String   @id @default(uuid())
  make      String
  model     String
  category  String
  price     Float
  quantity  Int      @default(0)
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases Purchase[]
  wishlists Wishlist[]

  @@map("vehicles")
}

model Purchase {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  vehicleId       String   @map("vehicle_id")
  quantity        Int      @default(1)
  priceAtPurchase Float    @map("price_at_purchase")
  totalAmount     Float    @map("total_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([vehicleId])
  @@map("purchases")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  vehicleId String   @map("vehicle_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([userId])
  @@index([vehicleId])
  @@map("wishlists")
}
